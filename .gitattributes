# The golden-vector corpus is compared byte for byte by
# `cargo test --test export_baseline_vectors`. On a clone with
# `core.autocrlf=true` an untranslated checkout would add CR bytes and the
# comparison would fail, so line endings are pinned here. Every vector file is
# generated with LF only.
test/vectors/** text eol=lf
test/p31-vectors/** text eol=lf
test/p32-vectors/** text eol=lf
test/p33-vectors/** text eol=lf
# The P4.1A claimed-root corpus is the same protocol with its own corpus root.
test/p41-vectors/** text eol=lf
